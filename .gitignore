# ===== 白名单模式：默认忽略所有文件 =====
*

# ===== 保留的文件 =====
!.gitignore
!01create_model.py
!02predict_test_image.py
!03predict_test_video.py
!04predict_test_webcam.py
!app1.py
!app2.py
!my_train_model.py
!*.yaml

# ===== 保留前端目录（需先放行目录本身，git 才会进入遍历）=====
!yoloyolo/
!yoloyolo/**

# ===== yoloyolo 内部仍排除构建产物与依赖 =====
yoloyolo/unpackage/
yoloyolo/node_modules/
